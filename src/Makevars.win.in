TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu

TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/libicebergr.a

# tokio, reqwest and rustls all need Windows system libraries that cargo cannot
# communicate to R's linker. If a link error names a missing symbol, the
# --print=native-static-libs output in the build log lists the authoritative set.
PKG_LIBS = -L$(LIBDIR) -licebergr \
	-lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -lcrypt32 -lsecur32 \
	-lncrypt -lkernel32 -lole32 -loleaut32 -lpsapi

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = vendor

# Makevars.ucrt sets CARGO_LINKER to the Rtools linker that cargo's windows-gnu
# target cannot find on its own. cargo reads it from a per-target environment
# variable whose name is the target, upper-cased with dashes as underscores.
#
# It is only exported when CARGO_LINKER names something actually on the PATH:
# when it is unset, or names a binary this Rtools does not ship, the export is
# skipped and cargo's own default linker applies, exactly as before.
TARGET_ENV = $(shell echo $(TARGET) | tr 'a-z-' 'A-Z_')
CARGO_LINKER_FOUND = $(shell command -v $(CARGO_LINKER) 2>/dev/null)

$(STATLIB):
	# Rtools' gcc does not ship libgcc_eh.a where the gnu target expects it, so
	# an empty stand-in is provided.
	mkdir -p $(TARGET_DIR)/libgcc_mock
	touch $(TARGET_DIR)/libgcc_mock/libgcc_eh.a

	if [ "$(NOT_CRAN)" != "true" ]; then \
		if [ -f ./rust/vendor.tar.xz ]; then \
			tar xf rust/vendor.tar.xz && \
			mkdir -p $(CARGOTMP) && \
			cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
		fi; \
	fi

	export CARGO_HOME=$(CARGOTMP) && \
	$(if $(CARGO_LINKER_FOUND),export CARGO_TARGET_$(TARGET_ENV)_LINKER="$(CARGO_LINKER)" &&,) \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CURDIR)/$(TARGET_DIR)/libgcc_mock" && \
	RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build @CRAN_FLAGS@ @FEATURES@ --target=$(TARGET) --lib @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir=$(TARGET_DIR)

	rm -Rf $(CARGOTMP)

rust_clean: $(SHLIB)
	rm -Rf $(CARGOTMP) $(VENDOR_DIR) @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR) $(VENDOR_DIR) $(CARGOTMP)
