TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu

TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/libicebergr.a

# tokio, reqwest and rustls all need Windows system libraries that cargo cannot
# communicate to R's linker. If a link error names a missing symbol, the
# --print=native-static-libs output in the build log lists the authoritative set.
PKG_LIBS = -L$(LIBDIR) -licebergr \
	-lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -lcrypt32 -lsecur32 \
	-lncrypt -lkernel32 -lole32 -loleaut32 -lpsapi

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = vendor

# --ignore-rust-version: iceberg, iceberg-catalog-rest, iceberg-catalog-glue and
# fastnum declare rust-version = "1.94" under iceberg-rust's rolling-MSRV policy,
# and cargo rejects a build outright when a dependency declares more than the
# active toolchain. None of them needs it, and CRAN's Windows build farm carries
# 1.92, so the declaration alone would make this platform unbuildable.
# tools/msrv.R remains the gate on the real floor, which DESCRIPTION states.
#
# tools/config.R decides @USE_VENDOR@: true for a CRAN build that has
# vendor.tar.xz to unpack, in which case cargo is pointed at the unpacked tree
# and @CRAN_FLAGS@ carries --offline. It is false when NOT_CRAN is set, when the
# archive is absent, and when @FEATURES@ asks for an optional backend -- the
# archive is pruned down to the crates the default build compiles, so a feature
# build has to resolve from crates.io.
$(STATLIB):
	# Rtools' gcc does not ship libgcc_eh.a where the gnu target expects it, so
	# an empty stand-in is provided.
	mkdir -p $(TARGET_DIR)/libgcc_mock
	touch $(TARGET_DIR)/libgcc_mock/libgcc_eh.a

	if [ "@USE_VENDOR@" = "true" ]; then \
		tar xf rust/vendor.tar.xz && \
		mkdir -p $(CARGOTMP) && \
		cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
	fi

	export CARGO_HOME=$(CARGOTMP) && \
	if [ -n "$(CARGO_LINKER)" ] && command -v "$(CARGO_LINKER)" >/dev/null 2>&1; then \
		export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$(CARGO_LINKER)"; \
	fi && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CURDIR)/$(TARGET_DIR)/libgcc_mock" && \
	RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build --ignore-rust-version @CRAN_FLAGS@ @FEATURES@ --target=$(TARGET) --lib @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir=$(TARGET_DIR)

	rm -Rf $(CARGOTMP)

rust_clean: $(SHLIB)
	rm -Rf $(CARGOTMP) $(VENDOR_DIR) @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR) $(VENDOR_DIR) $(CARGOTMP)
