# Rtools42 and later do not place the linker where cargo's windows-gnu target
# expects it, so it is named explicitly here. Makevars.win exports it to cargo as
# CARGO_TARGET_<TARGET>_LINKER, and only if this binary is actually on the PATH.
CARGO_LINKER = x86_64-w64-mingw32.static.posix-gcc.exe

include Makevars.win
