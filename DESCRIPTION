Package: icebergr
Type: Package
Title: Read and Write Apache Iceberg Tables
Version: 0.1.0
Authors@R:
    c(person(given = "Youzhi",
             family = "Yu",
             role = c("aut", "cre"),
             email = "yuyouzhi666@icloud.com"),
      person(given = "The Apache Software Foundation",
